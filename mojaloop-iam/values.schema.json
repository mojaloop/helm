{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mojaloop-iam values",
  "description": "Checked by helm before anything is rendered, so a malformed roles file is a refused template rather than a failed rollout.",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "authz": {
          "description": "The services this deployment runs, one entry each.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "image", "spec", "url"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "image": { "type": "string", "minLength": 1 },
              "spec": {
                "description": "Where the OpenAPI document sits inside that image.",
                "type": "string",
                "pattern": "^/"
              },
              "url": {
                "type": "object",
                "required": ["host"],
                "properties": {
                  "host": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "pattern": "^/" }
                }
              }
            }
          }
        },
        "resourceNames": {
          "description": "One real thing under several services' names.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["members"],
            "properties": {
              "label": { "type": "string" },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["service", "type"],
                  "properties": {
                    "service": { "type": "string", "minLength": 1 },
                    "type": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "iamRoles": {
          "description": "The deployment's roles, the assignments it ships with, and the duties it keeps apart.",
          "type": "object",
          "required": ["roles"],
          "additionalProperties": false,
          "properties": {
            "roles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["grants"],
                "additionalProperties": false,
                "properties": {
                  "grants": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["permission"],
                      "additionalProperties": false,
                      "properties": {
                        "permission": {
                          "description": "<service>.<permission>, as the catalog spells it.",
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z0-9_.-]+$"
                        },
                        "resources": {
                          "description": "The resources this grant covers, per resource name the permission is scoped by: all, one id, or a list of ids. A scoped resource name left out is the assignment's to name.",
                          "type": "object",
                          "additionalProperties": {
                            "oneOf": [
                              { "type": "string", "minLength": 1 },
                              { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "assignments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["subject", "role"],
                "additionalProperties": false,
                "properties": {
                  "subject": { "type": "string", "minLength": 1 },
                  "role": { "type": "string", "minLength": 1 },
                  "resources": {
                    "description": "The resources this instance is about, one per resource name the role's grants leave open.",
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            },
            "exclusions": {
              "description": "Permissions that may not end up in one pair of hands.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "a", "b"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "a": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                  "b": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                }
              }
            }
          }
        }
      }
    }
  }
}
